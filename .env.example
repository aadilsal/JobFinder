# Copy to .env.local and fill in. Never commit .env.local.

# ---- required ----
# console.anthropic.com - powers CV parsing, AI match scores, tailoring and outreach
ANTHROPIC_API_KEY=

# ---- recommended ----
# github.com/settings/tokens (no scopes needed) - avoids GitHub rate limits when syncing repos
GITHUB_TOKEN=
# Contact address sent to browser push services
VAPID_EMAIL=you@example.com
# Your https:// address, used for links in notifications (docker compose sets this for you)
PUBLIC_URL=

# ---- optional ----
JOBKIT_MODEL=claude-sonnet-5-5
SCRAPE_EVERY_HOURS=6
# Adzuna job API (free): developer.adzuna.com
ADZUNA_APP_ID=
ADZUNA_APP_KEY=
# JSearch on RapidAPI (Google for Jobs: LinkedIn, Indeed, Glassdoor, ZipRecruiter...)
RAPIDAPI_KEY=
# Telegram bot from @BotFather; each user adds their chat id in Settings
TELEGRAM_BOT_TOKEN=
NTFY_SERVER=https://ntfy.sh
# Optional: otherwise a random one is generated into data/session_secret
SESSION_SECRET=
# CLI fallbacks
GITHUB_USER=
JOBKIT_USER=
